extends layout

block content
  header.w3-container.w3-black.w3-padding-32(style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;")
    
    div(style="display: flex; align-items: center;")
      a(href="/filmes" title="Voltar à lista de filmes" style="margin-right: 20px;")
        img(src="/images/filmTape.png" alt="Ícone Home" style="height: 50px; cursor: pointer; filter: invert(1);")
      
      div
        h1.w3-xxlarge.w3-wide.w3-uppercase(style="margin: 0;")= title
        p.w3-opacity(style="margin: 0; padding-top: 8px;") #{film.title} Info
        
  .w3-container.w3-padding-64.w3-content(style="max-width: 900px;")
    
    .w3-card-4.w3-white
      
      .w3-container.w3-center.w3-padding-32
        h2.w3-jumbo.w3-margin-bottom
          b= film.title
        h3.w3-text-dark-grey Year: #{film.year}
        p.w3-text-grey ID: #{film.id}
      
      hr(style="margin: 0 16px; border-top: 2px solid #eee;")

      .w3-row.w3-padding-32
        
        .w3-half.w3-container
          h4.w3-black.w3-center.w3-padding Genres
          ul.w3-ul.w3-hoverable.w3-border
            if film.genres && film.genres.length > 0
              each genero in film.genres
                li= genero
            else
              li.w3-text-grey.w3-center This film has no genres.

        .w3-half.w3-container
          h4.w3-dark-grey.w3-center.w3-padding Cast
          ul.w3-ul.w3-hoverable.w3-border
            if actors && actors.length > 0
              each name, index in actors
                li
                  a(href="/atores/" + film.cast[index] style="text-decoration: none; display: block;")
                    b= name
            else
              li.w3-text-grey.w3-center This film has no cast.