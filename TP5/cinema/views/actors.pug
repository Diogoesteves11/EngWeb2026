extends layout

block content
  header.w3-container.w3-black.w3-padding-32(style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;")
    
    div(style="display: flex; align-items: center;")
      a(href="/filmes" title="Voltar à lista de filmes" style="margin-right: 20px;")
        img(src="/images/filmTape.png" alt="Ícone Home" style="height: 50px; cursor: pointer; filter: invert(1);")
      
      div
        h1.w3-xxlarge.w3-wide.w3-uppercase Actor List
        p.w3-opacity List of all actors
        
    div(style="margin-top: 10px;")
      a.w3-button.w3-white.w3-text-black.w3-hover-light-grey.w3-round(href="/atores?_sort=name") 
        b Sort by Name

  .w3-container.w3-padding-64.w3-content(style="max-width: 1000px;")
    
    .w3-card-4.w3-white
      table.w3-table-all.w3-hoverable
        thead
          tr.w3-dark-grey
            th ID
            th Name
            th.w3-center # Films
        
        tbody
          if actors && actors.length > 0
            each actor in actors
              tr(style="cursor: pointer;" onclick=`window.location.href='/atores/${actor.id}'`).w3-hover-light-grey
                td= actor.id
                td
                  b= actor.name
                td.w3-center= actor.films ? actor.films.length : 0
          else
            tr
              td(colspan="3").w3-center.w3-padding-32 No actors found.