extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1.w3-left EMD List Page
      
      .w3-right(style="margin-top: 16px;")
        a.w3-btn.w3-white.w3-text-teal.w3-round.w3-hover-gray.w3-margin-right(href="/emd?_sort=dataEMD&_order=desc")
          b Order by Date
        a.w3-btn.w3-white.w3-text-teal.w3-round.w3-hover-gray.w3-margin-right(href="/emd?_sort=nome&_order=asc")
          b Order by Name
        a.w3-btn.w3-white.w3-text-teal.w3-round.w3-hover-gray.w3-margin-right(href="/emd/stats")
          b Stats
        a.w3-btn.w3-amber.w3-text-white.w3-round.w3-hover-orange(href="/emd/registo")
          b Resgister EMD
    
    .w3-container
      table.w3-table-all.w3-margin-top.w3-hoverable
        tr
          th Name
          th Date
          th Sport
          th Result
          th Actions
        each emd in list
          tr(onclick=`window.location='/emd/${emd.id}'` style="cursor: pointer;")
            td= emd.nome
            td= emd.dataEMD
            td= emd.modalidade
            td= emd.resultado ? 'Passed' : 'Failed'
            td
              a.w3-button.w3-blue.w3-small.w3-round.w3-margin-right(href=`/emd/editar/${emd.id}` onclick="event.stopPropagation()") Edit

              a.w3-button.w3-red.w3-small.w3-round(href=`/emd/apagar/${emd.id}` onclick="event.stopPropagation()") Delete