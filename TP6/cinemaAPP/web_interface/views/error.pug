extends layout

block content
  .w3-container.w3-padding-64

    .w3-card-4.w3-margin-bottom(style="max-width: 900px; margin: 0 auto;")
      
      header.w3-container.w3-red.w3-center.w3-padding-32
        h1.w3-xxxlarge
          b Something went wrong!
        h2.w3-xlarge Status: #{error.status}
      
      .w3-container.w3-white.w3-padding-16
        p.w3-text-grey.w3-large Error details:
        
        .w3-panel.w3-light-grey.w3-leftbar.w3-border-red(style="overflow-x: auto;")
          pre.w3-small(style="margin: 16px 0;") #{error.stack}
          
      footer.w3-container.w3-padding-16.w3-center.w3-white
        a.w3-button.w3-black.w3-hover-red.w3-round(href="/") Voltar à Página Inicial